# =============================================================================
# Bovaro environment variables
# =============================================================================
# Copy to .env.local for local development. Only the Supabase variables are
# required to run the app. Every other integration is optional: when its env
# vars are missing the corresponding module shows a clear "inte konfigurerad"
# state instead of pretending to work.
#
# Production minimum:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, NEXT_PUBLIC_SITE_URL, CRON_SECRET,
#   RATE_LIMIT_SECRET, IDENTITY_HASH_SECRET

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key for cron jobs, webhooks and admin batch operations.
# NEVER expose to the client and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.bovaro.se

# --- Email (Resend) ----------------------------------------------------------
# Transactional email. Without a key, dev mode logs emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Bovaro <noreply@bovaro.se>

# --- Billing (Stripe) --------------------------------------------------------
# Checkout is server-side Stripe Checkout; no publishable key is needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Identity verification (BankID provider) ---------------------------------
# Provider abstraction lives in lib/identity/. In development a mock provider
# is used; production requires these to be set.
BANKID_API_URL=
BANKID_CLIENT_CERT=
BANKID_CLIENT_KEY=
BANKID_CA_CERT=
# Set to "mock" only in development/staging to enable the labeled mock provider.
IDENTITY_PROVIDER=
# Secret used to HMAC-hash personal identity numbers (never stored in
# plaintext). REQUIRED in production; falls back to RATE_LIMIT_SECRET.
IDENTITY_HASH_SECRET=

# --- E-signing provider (contracts) -------------------------------------------
# ESIGN_PROVIDER=mock enables the labeled mock in development.
ESIGN_PROVIDER=
# Shared secret used to verify signatures on incoming e-sign webhooks.
ESIGN_WEBHOOK_SECRET=

# --- Credit/income screening provider -----------------------------------------
# SCREENING_PROVIDER=mock enables the labeled mock in development.
SCREENING_PROVIDER=

# --- Maps / geocoding ----------------------------------------------------------
# Set GEOCODING_PROVIDER=nominatim and GEOCODING_API_URL to a Nominatim-
# compatible endpoint to enable forward geocoding of listing addresses.
GEOCODING_PROVIDER=
GEOCODING_API_URL=

# --- Monitoring (Sentry, server-side only) --------------------------------------
SENTRY_DSN=

# --- Scheduled jobs -------------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (Authorization: Bearer <secret>).
# REQUIRED in production; cron routes return 503 without it.
CRON_SECRET=

# --- Rate limiting ---------------------------------------------------------------
# Secret used to hash rate-limit subjects (IP/user) before storage.
# REQUIRED in production; rate-limited actions are denied without it.
RATE_LIMIT_SECRET=

# --- Push notifications (Web Push / VAPID) ----------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bovaro.se

# =============================================================================
# Test / script variables (never needed at runtime)
# =============================================================================

# --- Playwright E2E (npm run test:e2e) --------------------------------------------
# Base URL of the app under test; defaults to http://localhost:3000.
E2E_BASE_URL=
# Seeded test accounts (see scripts/seed-e2e.mjs). E2E specs that need a login
# are skipped when these are unset.
E2E_SEEKER_EMAIL=
E2E_SEEKER_PASSWORD=
E2E_LANDLORD_EMAIL=
E2E_LANDLORD_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Password used by scripts/seed-e2e.mjs when creating the accounts above.
E2E_SEED_PASSWORD=

# --- Demo reset (scripts/demo-reset.mjs) ------------------------------------------
DEMO_PASSWORD=
