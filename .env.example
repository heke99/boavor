# =============================================================================
# Bovaro environment variables
# =============================================================================
# Copy to .env.local for local development. Only the Supabase variables are
# required to run the app. Every other integration is optional: when its env
# vars are missing the corresponding module shows a clear "inte konfigurerad"
# state instead of pretending to work.

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only key for cron jobs, webhooks and admin batch operations.
# NEVER expose to the client and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.bovaro.se

# --- Email (Resend) ----------------------------------------------------------
# Transactional email. Without a key, dev mode logs emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Bovaro <noreply@bovaro.se>

# --- Billing (Stripe) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Identity verification (BankID provider) ---------------------------------
# Provider abstraction lives in lib/identity/. In development a mock provider
# is used; production requires these to be set.
BANKID_API_URL=
BANKID_CLIENT_CERT=
BANKID_CLIENT_KEY=
BANKID_CA_CERT=
# Set to "mock" only in development/staging to enable the labeled mock provider.
IDENTITY_PROVIDER=
# Secret used to HMAC-hash personal identity numbers (never stored in plaintext).
IDENTITY_HASH_SECRET=

# --- E-signing provider (contracts) -------------------------------------------
ESIGN_PROVIDER=
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# --- Credit/income screening provider -----------------------------------------
SCREENING_PROVIDER=
SCREENING_API_KEY=

# --- Maps / geocoding ----------------------------------------------------------
# Set GEOCODING_PROVIDER=nominatim and GEOCODING_API_URL to a Nominatim-
# compatible endpoint to enable forward geocoding of listing addresses.
GEOCODING_PROVIDER=
GEOCODING_API_URL=
GEOCODING_API_KEY=

# --- Monitoring (Sentry) -------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Scheduled jobs -------------------------------------------------------------
# Shared secret required by /api/cron/* endpoints (Authorization: Bearer <secret>).
CRON_SECRET=

# --- Rate limiting ---------------------------------------------------------------
# Secret used to hash rate-limit subjects (IP/user) before storage.
RATE_LIMIT_SECRET=

# --- Push notifications (Web Push / VAPID) ----------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bovaro.se

# --- Outgoing webhooks (public API) -------------------------------------------------
# Secret used to sign webhook payloads delivered to landlord integrations.
WEBHOOK_SIGNING_SECRET=

# --- Public API -----------------------------------------------------------------------
# Pepper used when hashing API keys at rest.
API_KEY_HASH_SECRET=

# --- Migration/import center ------------------------------------------------------------
# Storage bucket for landlord import files (CSV/XLSX/JSON). Defaults to
# "migration-imports" when unset.
MIGRATION_IMPORT_BUCKET=
